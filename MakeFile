# ============================================================================
# JusticeFlow Makefile
# ============================================================================
# Comprehensive build system for the JusticeFlow platform
#
# Usage:
#   make              - Build everything (default)
#   make clean        - Remove all build artifacts
#   make test         - Run all tests
#   make install      - Install binaries to /usr/local/bin
#   make docs         - Generate documentation
#   make format       - Format code with clang-format
#   make lint         - Run static analysis
#

# ============================================================================
# Configuration
# ============================================================================

PROJECT_NAME    := justiceflow
VERSION         := 1.0.0
BUILD_DIR       := build
SRC_DIR         := src
TEST_DIR        := tests
INSTALL_PREFIX  := /usr/local

# Compiler settings
CXX             := g++
CXXFLAGS        := -std=c++17 -Wall -Wextra -fPIC
CXXFLAGS_DEBUG  := $(CXXFLAGS) -g -O0 -DDEBUG
CXXFLAGS_RELEASE:= $(CXXFLAGS) -O3 -DNDEBUG

# Linker settings
LDFLAGS         := -L$(BUILD_DIR)/lib -L/usr/lib/postgresql
LDLIBS          := -lpq -lpthread -lreadline -ldl -lm

# Include paths
INCLUDE_DIRS    := -I. -I$(SRC_DIR) -I/usr/include/postgresql

# Targets
EXECUTABLE      := $(BUILD_DIR)/justiceflow
TEST_EXECUTABLE := $(BUILD_DIR)/justiceflow_test

# Platform detection
UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Linux)
    LDLIBS += -lrt
endif

# Build mode (debug by default)
BUILD_MODE      ?= debug
ifeq ($(BUILD_MODE),debug)
    CXXFLAGS    := $(CXXFLAGS_DEBUG)
    OPTIMIZE    := -g
else
    CXXFLAGS    := $(CXXFLAGS_RELEASE)
    OPTIMIZE    := -O3
endif

# ============================================================================
# Source Files
# ============================================================================

# Common sources
COMMON_SOURCES := \
	$(SRC_DIR)/common/logger.cpp

# OS Layer sources
OS_LAYER_SOURCES := \
	$(SRC_DIR)/os_layer/scheduler/src/scheduler.cpp \
	$(SRC_DIR)/os_layer/scheduler/src/daemon.cpp \
	$(SRC_DIR)/os_layer/scheduler/src/timer.cpp \
	$(SRC_DIR)/os_layer/scheduler/src/signal_handler.cpp \
	$(SRC_DIR)/os_layer/scheduler/src/job_executor.cpp \
	$(SRC_DIR)/os_layer/scheduler/src/process_spawner.cpp \
	$(SRC_DIR)/os_layer/ipc/src/ipc_manager.cpp \
	$(SRC_DIR)/os_layer/ipc/src/unix_socket.cpp \
	$(SRC_DIR)/os_layer/ipc/src/fifo.cpp \
	$(SRC_DIR)/os_layer/ipc/src/shared_memory.cpp \
	$(SRC_DIR)/os_layer/ipc/src/domain_socket.cpp \
	$(SRC_DIR)/os_layer/ipc/src/socket_request.cpp \
	$(SRC_DIR)/os_layer/threading/src/thread_pool.cpp \
	$(SRC_DIR)/os_layer/threading/src/worker.cpp \
	$(SRC_DIR)/os_layer/threading/src/session_manager.cpp \
	$(SRC_DIR)/os_layer/threading/src/connection_gate.cpp \
	$(SRC_DIR)/os_layer/memory/src/mmap_handler.cpp \
	$(SRC_DIR)/os_layer/memory/src/mlock_guard.cpp \
	$(SRC_DIR)/os_layer/process/src/process_manager.cpp \
	$(SRC_DIR)/os_layer/process/src/process_registry.cpp

# System Layer sources (auth + subsystems)
SYSTEM_LAYER_SOURCES := \
	$(SRC_DIR)/system/shr_infra/auth/src/auth_manager.cpp \
	$(SRC_DIR)/system/shr_infra/auth/src/session_store.cpp \
	$(SRC_DIR)/system/shr_infra/auth/src/duty_cache.cpp \
	$(SRC_DIR)/system/shr_infra/auth/src/token_generator.cpp \
	$(SRC_DIR)/system/subsystem1/src/case_manager.cpp \
	$(SRC_DIR)/system/subsystem1/src/case_strategy.cpp \
	$(SRC_DIR)/system/subsystem1/src/evidence_mgr.cpp \
	$(SRC_DIR)/system/subsystem1/src/observer.cpp \
	$(SRC_DIR)/system/subsystem1/src/office_mgr.cpp \
	$(SRC_DIR)/system/subsystem1/src/report_factory.cpp \
	$(SRC_DIR)/system/subsystem1/subsystem1.cpp \
	$(SRC_DIR)/system/subsystem2/src/controllers/CaseManager.cpp \
	$(SRC_DIR)/system/subsystem2/src/controllers/EvidenceManager.cpp \
	$(SRC_DIR)/system/subsystem2/src/controllers/InvestigationManager.cpp \
	$(SRC_DIR)/system/subsystem2/src/models/Case.cpp \
	$(SRC_DIR)/system/subsystem2/src/models/Evidence.cpp \
	$(SRC_DIR)/system/subsystem2/src/models/ChargeSheet.cpp \
	$(SRC_DIR)/system/subsystem2/subsystem2.cpp \
	$(SRC_DIR)/system/subsystem3/audit/src/audit_manager.cpp \
	$(SRC_DIR)/system/subsystem3/audit/src/audit_query.cpp \
	$(SRC_DIR)/system/subsystem3/enforcement/src/warrant_manager.cpp \
	$(SRC_DIR)/system/subsystem3/enforcement/src/arrest_manager.cpp \
	$(SRC_DIR)/system/subsystem3/enforcement/src/bail_manager.cpp \
	$(SRC_DIR)/system/subsystem3/forensic/src/forensic_manager.cpp \
	$(SRC_DIR)/system/subsystem3/forensic/src/forensic_repository.cpp \
	$(SRC_DIR)/system/subsystem3/subsystem3.cpp \
	$(SRC_DIR)/system.cpp

# API Gateway sources
API_GATEWAY_SOURCES := \
	$(SRC_DIR)/api_gateway/api_gateway.cpp

# CLI sources
CLI_SOURCES := \
	$(SRC_DIR)/interface/cli.cpp

# Main application sources
MAIN_SOURCES := \
	$(SRC_DIR)/main.cpp

# All sources
ALL_SOURCES := \
	$(COMMON_SOURCES) \
	$(OS_LAYER_SOURCES) \
	$(SYSTEM_LAYER_SOURCES) \
	$(API_GATEWAY_SOURCES) \
	$(CLI_SOURCES) \
	$(MAIN_SOURCES)

# Object files
OBJECTS := $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(ALL_SOURCES))

# ============================================================================
# Test Sources
# ============================================================================

TEST_SOURCES := \
	$(TEST_DIR)/cli_test.cpp \
	$(TEST_DIR)/orchestrator_test.cpp \
	$(TEST_DIR)/system_integration_test.cpp \
	$(TEST_DIR)/os_layer_test.cpp

TEST_OBJECTS := $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(TEST_SOURCES))

# ============================================================================
# Phony Targets
# ============================================================================

.PHONY: all clean test install uninstall docs format lint help debug release

# ============================================================================
# Default Target
# ============================================================================

all: $(EXECUTABLE)

# ============================================================================
# Main Executable
# ============================================================================

$(EXECUTABLE): $(OBJECTS) | $(BUILD_DIR)
	@echo "Linking $@..."
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) $(OPTIMIZE) -o $@ $^ $(LDFLAGS) $(LDLIBS)
	@echo "✓ Build complete: $@"
	@ls -lh $@

# ============================================================================
# Object Files
# ============================================================================

$(BUILD_DIR)/%.o: %.cpp | $(BUILD_DIR)
	@mkdir -p $(@D)
	@echo "Compiling $<..."
	$(CXX) $(CXXFLAGS) $(OPTIMIZE) $(INCLUDE_DIRS) -c $< -o $@

# ============================================================================
# Test Executable
# ============================================================================

test: $(BUILD_DIR)/test_suite
	@echo "Running test suite..."
	$(BUILD_DIR)/test_suite

$(BUILD_DIR)/test_suite: $(filter-out $(BUILD_DIR)/$(SRC_DIR)/main.o,$(OBJECTS)) $(TEST_OBJECTS) | $(BUILD_DIR)
	@echo "Linking test suite..."
	$(CXX) $(CXXFLAGS) $(OPTIMIZE) -o $@ $^ $(LDFLAGS) $(LDLIBS) -lgtest -lgtest_main
	@echo "✓ Test suite built: $@"

# ============================================================================
# Build Directory
# ============================================================================

$(BUILD_DIR):
	@mkdir -p $(BUILD_DIR)

# ============================================================================
# Clean
# ============================================================================

clean:
	@echo "Cleaning build artifacts..."
	@rm -rf $(BUILD_DIR)
	@find . -name "*.o" -delete
	@find . -name "*.a" -delete
	@find . -name "*.so" -delete
	@echo "✓ Clean complete"

# ============================================================================
# Install
# ============================================================================

install: $(EXECUTABLE)
	@echo "Installing $(PROJECT_NAME) to $(INSTALL_PREFIX)..."
	@mkdir -p $(INSTALL_PREFIX)/bin
	@mkdir -p $(INSTALL_PREFIX)/etc/justiceflow
	@mkdir -p /var/log/justiceflow
	@mkdir -p /var/run/justiceflow
	@cp $(EXECUTABLE) $(INSTALL_PREFIX)/bin/
	@cp config.yaml $(INSTALL_PREFIX)/etc/justiceflow/ 2>/dev/null || true
	@chmod 755 $(INSTALL_PREFIX)/bin/justiceflow
	@chmod 755 /var/log/justiceflow
	@chmod 755 /var/run/justiceflow
	@echo "✓ Installation complete"
	@echo "  Binary: $(INSTALL_PREFIX)/bin/justiceflow"
	@echo "  Config: $(INSTALL_PREFIX)/etc/justiceflow/config.yaml"
	@echo "  Logs:   /var/log/justiceflow"

# ============================================================================
# Uninstall
# ============================================================================

uninstall:
	@echo "Uninstalling $(PROJECT_NAME)..."
	@rm -f $(INSTALL_PREFIX)/bin/justiceflow
	@echo "✓ Uninstall complete"

# ============================================================================
# Documentation
# ============================================================================

docs:
	@echo "Generating documentation..."
	@mkdir -p $(BUILD_DIR)/docs
	@doxygen Doxyfile 2>/dev/null || echo "Warning: Doxygen not found"
	@echo "✓ Documentation generated in $(BUILD_DIR)/docs"

# ============================================================================
# Code Quality
# ============================================================================

format:
	@echo "Formatting code..."
	@find $(SRC_DIR) -name "*.cpp" -o -name "*.h" | xargs clang-format -i 2>/dev/null || \
		echo "Warning: clang-format not found"
	@echo "✓ Code formatted"

lint:
	@echo "Running static analysis..."
	@find $(SRC_DIR) -name "*.cpp" -o -name "*.h" | xargs clang-tidy 2>/dev/null || \
		echo "Warning: clang-tidy not found"

# ============================================================================
# Build Variants
# ============================================================================

debug: BUILD_MODE=debug
debug: clean all
	@echo "✓ Debug build complete"

release: BUILD_MODE=release
release: clean all
	@echo "✓ Release build complete"

# ============================================================================
# Development Targets
# ============================================================================

run: $(EXECUTABLE)
	@echo "Running $(EXECUTABLE)..."
	@$(EXECUTABLE)

run-debug: debug run

valgrind: $(EXECUTABLE)
	@echo "Running under Valgrind..."
	@valgrind --leak-check=full --show-leak-kinds=all --track-origins=yes $(EXECUTABLE)

gdb: $(EXECUTABLE)
	@echo "Starting GDB..."
	@gdb $(EXECUTABLE)

# ============================================================================
# Help
# ============================================================================

help:
	@echo "JusticeFlow Build System"
	@echo "========================"
	@echo ""
	@echo "Targets:"
	@echo "  make                - Build the project (default)"
	@echo "  make debug          - Build in debug mode with symbols"
	@echo "  make release        - Build in release mode optimized"
	@echo "  make clean          - Remove all build artifacts"
	@echo "  make test           - Run test suite"
	@echo "  make install        - Install to $(INSTALL_PREFIX)"
	@echo "  make uninstall      - Uninstall from $(INSTALL_PREFIX)"
	@echo "  make docs           - Generate Doxygen documentation"
	@echo "  make format         - Format code with clang-format"
	@echo "  make lint           - Run static analysis with clang-tidy"
	@echo "  make run            - Build and run the application"
	@echo "  make run-debug      - Build debug and run"
	@echo "  make valgrind       - Run under Valgrind memory checker"
	@echo "  make gdb            - Start GDB debugger"
	@echo "  make help           - Show this help message"
	@echo ""
	@echo "Variables:"
	@echo "  BUILD_MODE=debug|release  - Choose build mode (default: debug)"
	@echo "  INSTALL_PREFIX=<path>     - Installation prefix (default: /usr/local)"
	@echo ""
	@echo "Examples:"
	@echo "  make clean && make release"
	@echo "  make debug && make run"
	@echo "  sudo make install"

# ============================================================================
# Compiler Information
# ============================================================================

compiler-info:
	@echo "Compiler Information:"
	@echo "  CXX: $(CXX)"
	@$(CXX) --version
	@echo ""
	@echo "Build Settings:"
	@echo "  BUILD_MODE: $(BUILD_MODE)"
	@echo "  CXXFLAGS: $(CXXFLAGS)"
	@echo "  LDFLAGS: $(LDFLAGS)"
	@echo "  LDLIBS: $(LDLIBS)"

# ============================================================================
# Dependency Analysis (for future use)
# ============================================================================

dependencies:
	@echo "Checking dependencies..."
	@which pg_config > /dev/null || (echo "ERROR: PostgreSQL not found" && exit 1)
	@which g++ > /dev/null || (echo "ERROR: g++ not found" && exit 1)
	@pkg-config --exists libpq || (echo "ERROR: libpq not found" && exit 1)
	@echo "✓ All dependencies satisfied"

# ============================================================================
# Size Analysis
# ============================================================================

size: $(EXECUTABLE)
	@echo "Binary Size:"
	@ls -lh $(EXECUTABLE)
	@echo ""
	@echo "Breakdown:"
	@size $(EXECUTABLE)

# ============================================================================
# Statistics
# ============================================================================

stats:
	@echo "Code Statistics:"
	@echo ""
	@echo "Lines of Code:"
	@wc -l $(SRC_DIR)/**/*.cpp $(SRC_DIR)/**/*.h | tail -1
	@echo ""
	@echo "Files:"
	@find $(SRC_DIR) -name "*.cpp" -o -name "*.h" | wc -l
	@echo ""
	@echo "Comment Density:"
	@find $(SRC_DIR) -name "*.cpp" -o -name "*.h" -exec grep -c "^ *//" {} \; | awk '{s+=$1} END {print "Total comment lines: " s}'

# ============================================================================
# Version Info
# ============================================================================

version:
	@echo "JusticeFlow Version: $(VERSION)"
	@echo "Build Mode: $(BUILD_MODE)"
	@echo "Compiler: $(CXX)"
	@echo "C++ Standard: C++17"

# ============================================================================
# Default Output on Just 'make'
# ============================================================================

.DEFAULT_GOAL := all

# Suppress "Entering directory" messages
MAKEFLAGS += --no-print-directory

# ============================================================================
# End of Makefile
# ============================================================================